{
  "name": "distance-calculator",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:typecheck && npm run test:unit",
    "test:typecheck": "tsc --noEmit",
    "test:unit": "node tests/format.test.mjs",
    "preview": "vite preview",
    "start": "node server/index.js",
    "docker:build": "docker build -t distance-calculator .",
    "docker:run": "docker run -p 3000:3000 distance-calculator"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.59.4",
    "vite": "^5.4.2"
  }
}
